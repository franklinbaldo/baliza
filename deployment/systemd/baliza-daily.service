[Unit]
Description=Baliza Daily Data Extraction and Upload to Internet Archive
Documentation=https://github.com/franklinbaldo/baliza
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=baliza
WorkingDirectory=/opt/baliza
ExecStart=/opt/baliza/scripts/daily_pipeline.py
EnvironmentFile=/etc/baliza/environment

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/baliza/data /var/log/baliza

# Resource limits
MemoryLimit=1G
CPUQuota=50%
TasksMax=100

# Restart policy
Restart=on-failure
RestartSec=5min
StartLimitInterval=1h
StartLimitBurst=3

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=baliza-daily

[Install]
WantedBy=multi-user.target
