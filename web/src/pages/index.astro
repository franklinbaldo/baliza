---
import Layout from '../layouts/Layout.astro';
import CityHero from '../components/CityHero.svelte';
import CityPulse from '../components/CityPulse.svelte';
import HomeBuscaForm from '../components/HomeBuscaForm.svelte';
import MonitorGrid from '../components/MonitorGrid.astro';
import TrustStrip from '../components/TrustStrip.astro';
import OrnamentBand from '../components/OrnamentBand.astro';
import Dashboard from '../components/Dashboard.svelte';
import WatchList from '../components/WatchList.svelte';
import { IA_MANIFEST_URL } from '../lib/ia-manifest';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const resolve = (href: string) => `${BASE}${href.replace(/^\//, '')}`;

const TOOLS: Array<{
  label: string;
  blurb: string;
  href: string;
  external?: boolean;
}> = [
  {
    label: 'Explorador SQL (Beta)',
    blurb: 'Consultas abertas sobre os Parquets arquivados, direto no navegador.',
    href: resolve('explorador'),
  },
  {
    label: 'Atas de registro de preços',
    blurb: 'Compromissos vigentes que outros órgãos podem aderir.',
    href: resolve('atas'),
  },
  {
    label: 'Metodologia e quarentena',
    blurb: 'Como Baliza ingere, limpa e sinaliza anomalias antes de publicar.',
    href: resolve('sobre'),
  },
  {
    label: 'Para desenvolvedores',
    blurb: 'URLs estáveis em Python, R e JS — sem chave de API.',
    href: resolve('desenvolvedores'),
  },
  {
    label: 'Status do arquivo',
    blurb: 'Última sincronização com o PNCP e o Internet Archive.',
    href: resolve('status'),
  },
  {
    label: 'Datasets Parquet',
    blurb: 'Manifesto CSV com partição, URL e hash no Internet Archive.',
    href: IA_MANIFEST_URL,
    external: true,
  },
];
---

<Layout
  title="Baliza — contratações públicas da sua cidade"
  description="Baliza: painel civic das contratações públicas brasileiras. Acompanhe o que sua cidade está comprando no PNCP, com snapshots diários no Internet Archive, links estáveis e SQL aberto no navegador."
>
  <!-- 1. Hero: city-first. Defaults to Porto Velho, RO until the visitor picks. -->
  <CityHero client:load />

  <!-- 2. Immediate utility: real recent activity for the active city. -->
  <CityPulse client:load />

  <!-- 2b. Free-text escape hatch for visitors who know what they're looking
       for. Plain HTML GET form — zero JS on the homepage path (the island
       ships no client directive; Astro renders it to HTML at build time).
       BuscaView on the target page detects canonical PNCP-id shapes and
       forwards them to /contratacao. -->
  <section class="home-busca-strip" aria-labelledby="home-busca-title">
    <div class="container">
      <h2 id="home-busca-title" class="sr-only">Buscar no PNCP</h2>
      <HomeBuscaForm />
    </div>
  </section>

  <OrnamentBand variant="wave" height={36} />

  <!-- 3. What you can monitor — compact, citizen-legible prompts. -->
  <MonitorGrid />

  <!-- 4. Trust layer: archive, citability, analysis. -->
  <TrustStrip />

  <!-- 5. Sinal do arquivo: preservation signal backed by sync_stats.json. -->
  <section class="signal-strip" aria-labelledby="signal-title">
    <div class="container">
      <header class="signal-head">
        <span class="kicker">Sinal do arquivo</span>
        <h2 id="signal-title">O que Baliza já preservou</h2>
      </header>
      <Dashboard client:visible />
    </div>
  </section>

  <!-- 6. Watchlist: the "Acompanhar" buttons on detail views save to
       localStorage; this island surfaces them so the feature isn't invisible
       after the user clicks it. Renders nothing when the list is empty. -->
  <WatchList client:only="svelte" />

  <!-- 7. Utilidades avançadas: compact secondary entry points. Demoted link
       grid — no second hero. The single search input lives in section 2b. -->
  <section class="tools-strip" aria-labelledby="tools-title">
    <div class="container">
      <header class="tools-head">
        <span class="kicker">Utilidades avançadas</span>
        <h2 id="tools-title">Outras entradas no arquivo</h2>
        <p class="tools-sub">
          Para quem já sabe o que procurar: análise, dados brutos e metodologia.
        </p>
      </header>
      <ul class="tools-grid">
        {TOOLS.map((tool) => (
          <li class="tool-card">
            <a
              href={tool.href}
              rel={tool.external ? 'noopener' : undefined}
              target={tool.external ? '_blank' : undefined}
            >
              <span class="tool-label">
                {tool.label}
                {tool.external && <span aria-hidden="true"> ↗</span>}
              </span>
              <span class="tool-blurb">{tool.blurb}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .home-busca-strip {
    padding: var(--space-5) 0;
    background: var(--neutral-0);
    border-bottom: 1px solid var(--neutral-100);
  }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  .signal-strip {
    padding: var(--space-7) 0;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }
  .signal-head {
    max-width: 640px;
    margin-bottom: var(--space-4);
    display: grid;
    gap: var(--space-2);
  }
  .signal-head h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(24px, 2.4vw, 32px);
    letter-spacing: 0;
  }

  .tools-strip {
    padding: var(--space-8) 0;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }
  .tools-head {
    max-width: 640px;
    margin-bottom: var(--space-5);
    display: grid;
    gap: var(--space-2);
  }
  .tools-head h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(24px, 2.4vw, 32px);
    letter-spacing: 0;
  }
  .tools-sub {
    color: var(--color-text-dim);
    font-size: var(--text-md);
    line-height: 1.6;
  }

  .tools-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-3);
  }
  .tool-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-left: 5px solid var(--color-azul);
  }
  .tool-card:nth-child(2n) { border-left-color: var(--color-verde); }
  .tool-card:nth-child(3n) { border-left-color: var(--color-ouro); }
  .tool-card a {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4);
    color: inherit;
    text-decoration: none;
    height: 100%;
    border-left: 3px solid transparent;
    transition: background var(--duration-fast) var(--ease), transform var(--duration-fast) var(--ease), box-shadow var(--duration-fast) var(--ease);
  }
  .tool-card a:hover {
    background:
      linear-gradient(color-mix(in srgb, var(--color-bg) 94%, transparent), color-mix(in srgb, var(--color-bg) 94%, transparent)),
      linear-gradient(color-mix(in srgb, var(--color-text) 7%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--color-text) 7%, transparent) 1px, transparent 1px);
    background-size: auto, 16px 16px, 16px 16px;
    transform: translateY(-2px);
    box-shadow: var(--shadow-pool-sm);
  }
  .tool-card a:focus-visible {
    background: color-mix(in srgb, var(--color-azul) 9%, transparent);
  }
  .tool-label {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-md);
    color: var(--color-text);
  }
  .tool-blurb {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-dim);
  }
</style>
