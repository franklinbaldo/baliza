---
import Layout from '../layouts/Layout.astro';
import RawArchiveStatus from '../components/RawArchiveStatus.svelte';
import CoverageReport from '../components/CoverageReport.svelte';
---

<Layout
  title="Status do Pipeline"
  description="Monitoramento da integridade do pipeline de dados Baliza."
>
  <section>
    <div>
      <div>
        <h1>Status do Pipeline</h1>
        <span>🟢 Operacional</span>
      </div>
      <p>
        Acompanhe o estado do item bruto no Internet Archive. Esta tela lê
        diretamente os metadados públicos de <code>baliza-pncp-raw</code>,
        incluindo arquivos ZIP, tamanho, cobertura e atualização do item.
      </p>
    </div>

    <div>
      <RawArchiveStatus client:load />
    </div>

    <div>
      <CoverageReport client:visible />
    </div>
  </section>
</Layout>

