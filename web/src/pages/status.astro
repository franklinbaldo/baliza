---
import Layout from '../layouts/Layout.astro';
import Dashboard from '../components/Dashboard.svelte';
---

<Layout
  title="Status do Pipeline"
  description="Monitoramento da integridade do pipeline de dados Baliza."
>
  <section class="status-section container">
    <div class="status-header">
      <h1 class="section-title">Status do Pipeline</h1>
      <p class="section-desc">
        Acompanhe o processo de sincronização da extração de dados do PNCP.
        O Baliza sincroniza diariamente os dados públicos de contratação.
      </p>
    </div>

    <div class="status-content">
      <Dashboard client:load />
    </div>
  </section>
</Layout>

<style>
  .status-section {
    padding: var(--space-2xl) 0;
  }
  .status-header {
    margin-bottom: var(--space-xl);
  }
  .section-title {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--space-xs);
    color: var(--color-primary);
  }
  .section-desc {
    color: var(--color-secondary);
    font-size: var(--font-size-md);
    line-height: 1.6;
    max-width: 72ch;
  }
  .status-content {
    background: var(--color-base-200);
    padding: var(--space-xl);
    border-radius: var(--radius-box);
    border: 1px solid var(--color-base-300);
  }
</style>
