---
import { ICON_PATHS, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  label?: string;
}

const { name, label } = Astro.props;
const inner = ICON_PATHS[name];
---
<svg
  data-icon
  viewBox="0 0 24 24"
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
  set:html={inner}
/>
