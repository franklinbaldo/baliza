---
// Compact "o que dá para monitorar" grid. Each cell is a real internal link;
// the Bulcão tile strip is a single structural accent per card, not decoration
// stacked on top of content.
import { DEFAULT_CITY } from '../lib/cityContext.svelte';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const resolve = (href: string) => `${BASE}${href.replace(/^\//, '')}`;

// /municipio and /orgao render EntityNotFound without their query params, so
// static homepage CTAs land a cold visitor on the default-lens city page.
// Users who have already picked a city get the personalized view in
// CityWowStrip above; this grid is the "what else you can do" showcase.
const DEFAULT_CITY_HREF = `municipio?ibge=${DEFAULT_CITY.ibge}`;

const ITEMS = [
  {
    title: 'Contratos recentes',
    question: 'O que a prefeitura está comprando esta semana?',
    cta: 'Ver contratos',
    href: DEFAULT_CITY_HREF,
    icon: '🛒',
  },
  {
    title: 'Concentração de fornecedores',
    question: 'Um CNPJ reaparece com frequência em diferentes órgãos?',
    cta: 'Investigar',
    href: 'explorador',
    icon: '🏢',
  },
  {
    title: 'Contratações por secretaria',
    question: 'Qual secretaria publicou mais no mês corrente?',
    cta: 'Ver por órgão',
    href: DEFAULT_CITY_HREF,
    icon: '🏛️',
  },
  {
    title: 'Atas de registro de preços',
    question: 'Quais compromissos vigentes a cidade mantém com fornecedores?',
    cta: 'Consultar atas',
    href: 'atas',
    icon: '📒',
  },
  {
    title: 'Dispensas e inexigibilidades',
    question: 'Houve pico de contratação sem concorrência?',
    cta: 'Verificar dispensas',
    href: 'dispensas',
    icon: '⚖️',
  },
  {
    title: 'Variações atípicas no valor',
    question: 'Um fornecedor cobra muito mais caro que a média do mercado?',
    cta: 'Analisar preços',
    href: 'explorador',
    icon: '📈',
  },
];
---

<section aria-labelledby="monitor-title">
  <hgroup>
    <small>O que você pode monitorar agora</small>
    <h2 id="monitor-title">Perguntas com resposta, não com planilha</h2>
    <p>
      Os mesmos dados públicos do PNCP — organizados para que você chegue
      à resposta em vez de ter que construir a pergunta em SQL.
    </p>
  </hgroup>

  <div class="grid">
    {ITEMS.map((item) => (
      <article>
        <figure aria-hidden="true" style="font-size: 2.5rem; margin: 0 0 var(--pico-spacing)">{item.icon}</figure>
        <strong>{item.title}</strong>
        <p><small>{item.question}</small></p>
        <footer>
          <a href={resolve(item.href)}>{item.cta} →</a>
        </footer>
      </article>
    ))}
  </div>
</section>

