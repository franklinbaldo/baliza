---
import { HOW_IT_WORKS_CARDS } from '../lib/homepage-content';
---

<section class="anatomy-section">
  <div class="container">
    <div class="anatomy-grid">
      <div class="anatomy-intro">
        <h2 class="section-title">Como garantimos a transparência?</h2>
        <p class="section-desc">
          O Baliza não é apenas um espelho. É um sistema de preservação ativa
          que remove intermediários entre você e os registros oficiais.
        </p>
      </div>

      <div class="cards-grid">
        {HOW_IT_WORKS_CARDS.map(card => (
          <div class="anatomy-card">
            <span class="card-icon">{card.icon}</span>
            <h3 class="card-title">{card.title}</h3>
            <p class="card-text">{card.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .anatomy-section {
    padding: var(--space-3xl) 0;
    background: var(--color-base-100);
  }
  .anatomy-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }
  @media (min-width: 900px) {
    .anatomy-grid {
      grid-template-columns: 350px 1fr;
      align-items: center;
    }
  }
  .section-title {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--space-sm);
    color: var(--color-primary);
  }
  .section-desc {
    color: var(--color-secondary);
    font-size: var(--font-size-base);
  }
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-md);
  }
  .anatomy-card {
    padding: var(--space-md);
    background: var(--color-base-200);
    border-radius: var(--radius-box);
    border: 1px solid var(--color-base-300);
    transition: transform 0.2s;
  }
  .anatomy-card:hover {
    transform: translateY(-5px);
    border-color: var(--color-primary);
  }
  .card-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: var(--space-xs);
  }
  .card-title {
    font-size: var(--font-size-base);
    font-weight: 700;
    margin-bottom: var(--space-xs);
  }
  .card-text {
    font-size: var(--font-size-sm);
    color: var(--color-secondary);
    line-height: 1.5;
  }
</style>
