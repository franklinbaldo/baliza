---
import { JOURNEYS } from '../lib/homepage-content';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const resolveHref = (href: string) => {
  if (href.startsWith('#')) return href;
  return `${BASE}${href.replace(/^\//, '')}`;
};

const STATUS_LABEL: Record<'green' | 'wip' | 'planned', string> = {
  green: 'Disponível',
  wip: 'Parcial',
  planned: 'Planejado',
};
---

<section class="journeys-section" aria-labelledby="journeys-title">
  <div class="container">
    <div class="journeys-header">
      <h2 id="journeys-title" class="section-title">Por onde começar?</h2>
      <p class="section-desc">
        O Baliza é construído primeiro para quem trabalha com licitação no dia a dia — fornecedores e compradores públicos. Quando resolvemos o caso exigente, as capacidades descem para jornalistas, pesquisadores e cidadãos. Escolha seu ponto de partida:
      </p>
    </div>

    <ul class="journey-grid">
      {JOURNEYS.map((j, index) => (
        <li class={`journey-card journey-${j.status}`}>
          <a href={resolveHref(j.href)} class="journey-link">
            <div class="journey-head">
              <div style="display:flex; align-items:center;">
                <svg width="24" height="24" aria-hidden="true" style="margin-right: 8px; flex-shrink:0;"><use href={`#t${(index % 5) + 1}`}/></svg>
                <span class="journey-icon" aria-hidden="true">{j.icon}</span>
              </div>
              <span class={`journey-status status-${j.status}`}>{STATUS_LABEL[j.status]}</span>
            </div>
            <h3 class="journey-role">{j.role}</h3>
            <p class="journey-question">"{j.question}"</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .journeys-section {
    padding: var(--space-8) 0;
    background: var(--neutral-50);
    border-top: 1px solid var(--neutral-100);
    border-bottom: 1px solid var(--neutral-100);
  }
  .journeys-header {
    max-width: 780px;
    margin-bottom: var(--space-6);
  }
  .section-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
    color: var(--bulcao-accent);
  }
  .section-desc {
    color: var(--neutral-500);
    line-height: 1.6;
    font-size: var(--text-md);
  }
  .journey-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
  }
  .journey-card {
    background: var(--neutral-0);
    border: 1px solid var(--neutral-200);
    border-radius: var(--radius-0);
    transition: all var(--duration-fast) var(--ease);
  }
  .journey-card:hover {
    border-color: var(--bulcao-accent);
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--bulcao-accent);
  }
  .journey-link {
    display: block;
    padding: var(--space-4);
    text-decoration: none;
    color: inherit;
    height: 100%;
  }
  .journey-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
  }
  .journey-icon {
    font-size: 1.6rem;
  }
  .journey-status {
    font-family: var(--font-mono, monospace);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-0);
    border: 1px solid currentColor;
  }
  .status-green { color: var(--color-success); }
  .status-wip { color: var(--color-warning); }
  .status-planned { color: var(--neutral-500); opacity: 0.85; }
  .journey-role {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
    margin: 0 0 var(--space-1);
    color: var(--bulcao-fg);
  }
  .journey-question {
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--neutral-500);
    font-style: italic;
    margin: 0;
  }
</style>
