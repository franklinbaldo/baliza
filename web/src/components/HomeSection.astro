---
interface Props {
  id: string;
  kicker?: string;
  title: string;
  titleHidden?: boolean;
}

const { id, kicker, title, titleHidden = false } = Astro.props;
---

<section aria-labelledby={id}>
  {titleHidden ? (
    <h2 id={id} class="sr-only">{title}</h2>
  ) : (
    <header>
      <hgroup>
        {kicker && <small>{kicker}</small>}
        <h2 id={id}>{title}</h2>
        <slot name="subtitle" />
      </hgroup>
      {Astro.slots.has('aside') && (
        <aside>
          <slot name="aside" />
        </aside>
      )}
    </header>
  )}
  <slot />
</section>
