---
interface Props {
  id: string;
  kicker?: string;
  title: string;
  titleHidden?: boolean;
  tone?: 'surface' | 'bg' | 'sunk';
  divider?: 'top' | 'bottom' | 'both' | 'none';
}

const {
  id,
  kicker,
  title,
  titleHidden = false,
  tone = 'surface',
  divider = 'bottom'
} = Astro.props;

const bgMap = {
  surface: 'var(--color-surface)',
  bg: 'var(--color-bg)',
  sunk: 'var(--color-surface-sunk)',
};

const borderMap = {
  top: 'border-top: 1px solid var(--color-border);',
  bottom: 'border-bottom: 1px solid var(--color-border);',
  both: 'border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);',
  none: '',
};
---

<section
  aria-labelledby={id}
  data-tone={tone}
>
  <div>
    {titleHidden ? (
      <h2 id={id}>{title}</h2>
    ) : (
      <header>
        <div>
          {kicker && <span>{kicker}</span>}
          <h2 id={id}>{title}</h2>
          <slot name="subtitle" />
        </div>
        {Astro.slots.has('aside') && (
          <div>
            <slot name="aside" />
          </div>
        )}
      </header>
    )}
    <div>
      <slot />
    </div>
  </div>
</section>

