---
interface Props {
  id: string;
  kicker?: string;
  title: string;
  titleHidden?: boolean;
  tone?: 'surface' | 'bg' | 'sunk';
  divider?: 'top' | 'bottom' | 'both' | 'none';
}

const {
  id,
  kicker,
  title,
  titleHidden = false,
  tone = 'surface',
  divider = 'bottom',
} = Astro.props;
---

<section aria-labelledby={id} data-tone={tone} data-divider={divider}>
  {titleHidden ? (
    <h2 id={id} class="sr-only">{title}</h2>
  ) : (
    <header>
      <hgroup>
        {kicker && <small>{kicker}</small>}
        <h2 id={id}>{title}</h2>
        <slot name="subtitle" />
      </hgroup>
      {Astro.slots.has('aside') && (
        <aside>
          <slot name="aside" />
        </aside>
      )}
    </header>
  )}
  <slot />
</section>
