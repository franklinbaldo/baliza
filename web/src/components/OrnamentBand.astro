---
// Restrained horizontal divider. One band per section boundary, never
// stacked. `variant="wave"` uses the Bulcão t4 sinusoid; `variant="volpi"`
// uses the tri-field color band (fg / bg / accent) referenced in the
// design system's antimodel rules.
interface Props {
  variant?: 'wave' | 'volpi';
  height?: number;
}
const { variant = 'wave', height = 32 }: Props = Astro.props;
---

{variant === 'wave' && (
  <hr aria-hidden="true" data-ornament="wave" style={`height:${height}px`} />
)}

{variant === 'volpi' && (
  <hr aria-hidden="true" data-ornament="volpi" style={`height:${height}px`} />
)}
{/* WHY inline style: only the band height varies per usage; everything
    visual lives in global.css via the [data-ornament] selectors. */}

