---
import ThemeToggle from './ThemeToggle.svelte';
import CityNavLink from './CityNavLink.svelte';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const { pathname } = Astro.url;
const isActive = (path: string) => {
  const target = path.startsWith(BASE) ? path : `${BASE}${path.replace(/^\//, '')}`;
  const cleanPath = pathname.replace(/\/$/, '') || '/';
  const cleanTarget = target.replace(/\/$/, '') || '/';
  return cleanPath === cleanTarget;
};
const cleanPath = pathname.replace(/\/$/, '') || '/';
const cityPrefix = (BASE + 'municipio').replace(/\/$/, '');
const isCityActive = cleanPath === cityPrefix;
---

<nav class="container">
  <ul>
    <li>
      <a href={BASE}>
        <strong>Baliza</strong> <small>Monitor</small>
      </a>
    </li>
  </ul>
  <ul>
    <li><CityNavLink client:load isActive={isCityActive} /></li>
    <li><a href={BASE + 'atas'} aria-current={isActive(BASE + 'atas') ? 'page' : undefined}>Atas</a></li>
    <li>
      <details role="list" dir="rtl">
        <summary aria-haspopup="listbox">Dados Abertos</summary>
        <ul role="listbox">
          <li><a href={BASE + 'explorador'}>Explorador SQL</a></li>
          <li><a href={BASE + 'desenvolvedores'}>Devs & API</a></li>
          <li><a href={BASE + 'status'}>Status do Arquivo</a></li>
        </ul>
      </details>
    </li>
    <li><a href={BASE + 'sobre'} aria-current={isActive(BASE + 'sobre') ? 'page' : undefined}>Sobre</a></li>
    <li>
      <a href={BASE + 'busca'} role="button" class="outline" aria-label="Buscar">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <span class="sr-only">Buscar</span>
      </a>
    </li>
    <li><ThemeToggle client:only="svelte" /></li>
  </ul>
</nav>

