---
import ThemeToggle from './ThemeToggle.svelte';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const { pathname } = Astro.url;
const isActive = (path: string) => {
  const target = path.startsWith(BASE) ? path : `${BASE}${path.replace(/^\//, '')}`;
  const cleanPath = pathname.replace(/\/$/, '') || '/';
  const cleanTarget = target.replace(/\/$/, '') || '/';
  return cleanPath === cleanTarget;
};
---

<nav class="nav">
  <div class="container nav-content">
    <a href={BASE} class="logo">
      <span class="logo-accent">Baliza</span> Monitor
    </a>
    
    <ul class="nav-links">
      <li><a href={BASE} class={isActive(BASE) ? 'active' : ''} aria-current={isActive(BASE) ? 'page' : undefined}>Início</a></li>
      <li><a href={BASE + 'explorador'} class={isActive(BASE + 'explorador') ? 'active' : ''} aria-current={isActive(BASE + 'explorador') ? 'page' : undefined}>Explorador</a></li>
      <li><a href={BASE + 'status'} class={isActive(BASE + 'status') ? 'active' : ''} aria-current={isActive(BASE + 'status') ? 'page' : undefined}>Status</a></li>
      <li><a href={BASE + 'sobre'} class={isActive(BASE + 'sobre') ? 'active' : ''} aria-current={isActive(BASE + 'sobre') ? 'page' : undefined}>Sobre</a></li>
    </ul>
    <ThemeToggle client:only="svelte" />
  </div>
</nav>

<style>
  .nav {
    background: var(--color-base-100);
    border-bottom: 1px solid var(--color-base-300);
    height: 4.5rem;
    display: flex;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .nav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    gap: var(--space-sm);
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-base-content);
    font-size: var(--font-size-lg);
    flex-shrink: 0;
  }
  .logo-accent {
    color: var(--color-primary);
    font-weight: 700;
  }
  .nav-links {
    list-style: none;
    display: flex;
    gap: var(--space-md);
    overflow-x: auto; /* Allow horizontal scroll on very small screens instead of breaking layout */
    -webkit-overflow-scrolling: touch;
    padding: 0.5rem 0;
    margin: 0;
  }
  .nav-links a {
    text-decoration: none;
    color: var(--color-secondary);
    font-weight: 600;
    font-size: var(--font-size-sm);
    transition: var(--transition-base);
    white-space: nowrap;
    border-bottom: 2px solid transparent;
  }
  .nav-links a:hover, .nav-links a.active {
    color: var(--color-primary);
  }
  .nav-links a.active {
    border-bottom-color: var(--color-primary);
  }

  /* Mobile Adjustments */
  @media (max-width: 600px) {
    .nav { height: auto; padding: 0.75rem 0; }
    .nav-content { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
    .nav-links { width: 100%; gap: var(--space-sm); justify-content: flex-start; }
    .logo { font-size: 1.1rem; }
  }
</style>
