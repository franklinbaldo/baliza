{
  "name": "baliza-web",
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-data.mjs && node scripts/build-municipalities.mjs && astro dev",
    "build": "node scripts/build-data.mjs && node scripts/build-municipalities.mjs && astro check && astro build && node scripts/check-bundle-size.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --fix",
    "_prep:stats": "cd .. && uv run python scripts/build_sync_stats.py",
    "check:full": "npm run _prep:stats && astro check && svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run _prep:stats && vitest run",
    "test:contracts": "vitest run src/lib/pncp.test.ts src/lib/pncpPublicacao.test.ts",
    "test:watch": "vitest",
    "test:bdd": "vitest run",
    "test:bdd:journeys": "vitest run src/components/__steps__/journeys",
    "test:bdd:green": "VITEST_INCLUDE_TAGS=green vitest run",
    "test:bdd:wip": "VITEST_INCLUDE_TAGS=wip vitest run",
    "test:bdd:planned": "VITEST_INCLUDE_TAGS=planned VITEST_EXCLUDE_TAGS=ignore vitest run",
    "test:bdd:report": "node scripts/bdd-report.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^8.1.2",
    "@duckdb/duckdb-wasm": "^1.33.1-dev45.0",
    "@picocss/pico": "^2.1.1",
    "@tanstack/svelte-query": "^6.1.34",
    "astro": "^6.4.8",
    "csv-parse": "^6.2.1",
    "papaparse": "^5.5.4",
    "svelte": "^5.56.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^6.5.0",
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/papaparse": "^5.5.2",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "astro-eslint-parser": "^1.4.0",
    "duckdb": "^1.2.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "svelte-check": "^4.6.0",
    "svelte-eslint-parser": "^1.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "tar": ">=7.5.11",
    "@tootallnate/once": ">=3.0.1",
    "yaml": ">=2.8.3"
  }
}
